diff --git a/cmake/platform/windows/windows.cmake b/cmake/platform/windows/windows.cmake
index 6aca043..0b65e91 100644
--- a/cmake/platform/windows/windows.cmake
+++ b/cmake/platform/windows/windows.cmake
@@ -1,4 +1,6 @@
-set(PLATFORM_REQUIRED_DEPS Detours Effects11)
+# kodi-rt: Detours is optional: its only user, the D3D driver hook in WinSystemWin32DX.cpp, is compiled out without it
+set(PLATFORM_REQUIRED_DEPS Effects11)
+list(APPEND PLATFORM_OPTIONAL_DEPS Detours)
 set(PLATFORM_REQUIRED_TOOLS EffectsCompiler Msys)
 
 list(APPEND PLATFORM_OPTIONAL_PACKAGES LibAACS LibBDPlus)
diff --git a/cmake/scripts/windows/ArchSetup.cmake b/cmake/scripts/windows/ArchSetup.cmake
index c02d8b7..333a89b 100644
--- a/cmake/scripts/windows/ArchSetup.cmake
+++ b/cmake/scripts/windows/ArchSetup.cmake
@@ -16,6 +16,11 @@ set(HOSTTOOLSET ${CMAKE_VS_PLATFORM_TOOLSET_HOST_ARCHITECTURE})
 if(CMAKE_GENERATOR_PLATFORM STREQUAL arm64)
   set(ARCH arm64)
   set(SDK_TARGET_ARCH arm64)
+elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL arm AND CMAKE_SIZEOF_VOID_P EQUAL 4)
+  # kodi-rt: Windows ARM32 (Windows RT 8.1). Built with Ninja and a toolchain file, where
+  # CMAKE_GENERATOR_PLATFORM is empty, so the toolchain's CMAKE_SYSTEM_PROCESSOR decides.
+  set(ARCH arm)
+  set(SDK_TARGET_ARCH arm)
 elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
   set(ARCH win32)
   set(SDK_TARGET_ARCH x86)
@@ -39,7 +44,10 @@ set(DEPS_FOLDER_RELATIVE project/BuildDependencies)
 # If we ever allow package.native other than 0_package.native-win32.list we will want to
 # adapt this based on host
 set(NATIVEPREFIX ${CMAKE_SOURCE_DIR}/${DEPS_FOLDER_RELATIVE}/tools)
-set(DEPENDS_PATH ${CMAKE_SOURCE_DIR}/${DEPS_FOLDER_RELATIVE}/${ARCH})
+# kodi-rt: an existing DEPENDS_PATH (-DDEPENDS_PATH=<prefix>) wins over the default folder
+if(NOT DEFINED DEPENDS_PATH)
+  set(DEPENDS_PATH ${CMAKE_SOURCE_DIR}/${DEPS_FOLDER_RELATIVE}/${ARCH})
+endif()
 set(MINGW_LIBS_DIR ${CMAKE_SOURCE_DIR}/${DEPS_FOLDER_RELATIVE}/mingwlibs/${ARCH})
 
 set(Msys_ROOT "${CMAKE_SOURCE_DIR}/${DEPS_FOLDER_RELATIVE}/msys64")
@@ -59,8 +67,8 @@ add_options(CXX ALL_BUILDS "/utf-8")
 add_options(CXX ALL_BUILDS "/wd\"4996\"")
 set(ARCH_DEFINES -D_WINDOWS -DTARGET_WINDOWS -DTARGET_WINDOWS_DESKTOP)
 
-# Do not add SSE flags for ARM64
-if(NOT CMAKE_GENERATOR_PLATFORM STREQUAL arm64)
+# Do not add SSE flags for ARM64 (kodi-rt: nor ARM32)
+if(NOT CMAKE_GENERATOR_PLATFORM STREQUAL arm64 AND NOT ARCH STREQUAL arm)
   list(APPEND ARCH_DEFINES -D__SSE__ -D__SSE2__)
 endif()
 
@@ -99,12 +107,22 @@ set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} /SAFESEH:NO")
 link_directories(${DEPENDS_PATH}/lib)
 
 # Additional libraries
-list(APPEND DEPLIBS bcrypt d3d11.lib DInput8.lib DSound.lib winmm.lib Mpr.lib Iphlpapi.lib ws2_32
+# kodi-rt: no DInput8.lib for ARM32 (SDK 10.0.19041 has no um\arm\dinput8.lib; no Kodi source uses DirectInput)
+if(NOT ARCH STREQUAL arm)
+  list(APPEND DEPLIBS DInput8.lib)
+endif()
+list(APPEND DEPLIBS bcrypt d3d11.lib DSound.lib winmm.lib Mpr.lib Iphlpapi.lib ws2_32
                     PowrProf.lib setupapi.lib Shlwapi.lib dwmapi.lib dxguid.lib DelayImp.lib RuntimeObject.lib)
 
 # NODEFAULTLIB option
-set(_nodefaultlibs_RELEASE libcmt)
-set(_nodefaultlibs_DEBUG libcmt msvcrt)
+if(CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded")
+  # kodi-rt: the static CRT (/MT, kodi-rt's toolchain files), whose library IS libcmt; keep the DLL CRTs out instead
+  set(_nodefaultlibs_RELEASE msvcrt)
+  set(_nodefaultlibs_DEBUG msvcrtd)
+else()
+  set(_nodefaultlibs_RELEASE libcmt)
+  set(_nodefaultlibs_DEBUG libcmt msvcrt)
+endif()
 foreach(_lib ${_nodefaultlibs_RELEASE})
   set(CMAKE_EXE_LINKER_FLAGS_RELEASE "${CMAKE_EXE_LINKER_FLAGS_RELEASE} /NODEFAULTLIB:\"${_lib}\"")
 endforeach()
diff --git a/cmake/scripts/windows/CFlagOverrides.cmake b/cmake/scripts/windows/CFlagOverrides.cmake
index 0c67794..100b244 100644
--- a/cmake/scripts/windows/CFlagOverrides.cmake
+++ b/cmake/scripts/windows/CFlagOverrides.cmake
@@ -7,6 +7,14 @@ if(MSVC)
   set(CMAKE_C_FLAGS "/D_UNICODE /DUNICODE /utf-8 /DRPC_USE_NATIVE_WCHAR ${MP_FLAG} /DWIN32 /D_WINDOWS /W3 /Zi")
   set(CMAKE_C_FLAGS_DEBUG "/D_DEBUG /MDd /Ob0 /Od /RTC1 /D_ITERATOR_DEBUG_LEVEL=0")
   set(CMAKE_C_FLAGS_RELEASE "/MD /Ox /Ob2 /Oi /Ot /Oy /GL /DNDEBUG")
+  if(CMAKE_SYSTEM_PROCESSOR STREQUAL arm)
+    # kodi-rt: Windows ARM32 with clang-cl. The lines above would replace the toolchain file's flags
+    # (--target, -vctoolsdir/-winsdkdir pins), so keep CMAKE_C_FLAGS_INIT in front. /MT: Windows RT 8.1
+    # has no UCRT or VC runtime DLLs. No /GL (LTO is off until Kodi runs), no /MP (clang-cl ignores it).
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS_INIT} /D_UNICODE /DUNICODE /utf-8 /DRPC_USE_NATIVE_WCHAR /DWIN32 /D_WINDOWS /W3 /Zi")
+    set(CMAKE_C_FLAGS_DEBUG "/D_DEBUG /MTd /Ob0 /Od /D_ITERATOR_DEBUG_LEVEL=0")
+    set(CMAKE_C_FLAGS_RELEASE "/MT /Ox /Ob2 /Oi /Ot /Oy /DNDEBUG")
+  endif()
 endif()
 
 if("$ENV{Platform}" STREQUAL "x86")
diff --git a/cmake/scripts/windows/CXXFlagOverrides.cmake b/cmake/scripts/windows/CXXFlagOverrides.cmake
index 3e9e7a1..db366a7 100644
--- a/cmake/scripts/windows/CXXFlagOverrides.cmake
+++ b/cmake/scripts/windows/CXXFlagOverrides.cmake
@@ -7,6 +7,14 @@ if(MSVC)
   set(CMAKE_CXX_FLAGS "/D_UNICODE /DUNICODE /utf-8 /DRPC_USE_NATIVE_WCHAR ${MP_FLAG} /DWIN32 /D_WINDOWS /W3 /GR /Zi /EHsc")
   set(CMAKE_CXX_FLAGS_DEBUG "/D_DEBUG /MDd /Ob0 /Od /RTC1 /D_ITERATOR_DEBUG_LEVEL=0")
   set(CMAKE_CXX_FLAGS_RELEASE "/MD /Ox /Ob2 /Oi /Ot /Oy /GL /DNDEBUG")
+  if(CMAKE_SYSTEM_PROCESSOR STREQUAL arm)
+    # kodi-rt: Windows ARM32 with clang-cl. The lines above would replace the toolchain file's flags
+    # (--target, -vctoolsdir/-winsdkdir pins), so keep CMAKE_CXX_FLAGS_INIT in front. /MT: Windows RT 8.1
+    # has no UCRT or VC runtime DLLs. No /GL (LTO is off until Kodi runs), no /MP (clang-cl ignores it).
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS_INIT} /D_UNICODE /DUNICODE /utf-8 /DRPC_USE_NATIVE_WCHAR /DWIN32 /D_WINDOWS /W3 /GR /Zi /EHsc")
+    set(CMAKE_CXX_FLAGS_DEBUG "/D_DEBUG /MTd /Ob0 /Od /D_ITERATOR_DEBUG_LEVEL=0")
+    set(CMAKE_CXX_FLAGS_RELEASE "/MT /Ox /Ob2 /Oi /Ot /Oy /DNDEBUG")
+  endif()
 endif()
 
 if("$ENV{Platform}" STREQUAL "x86")
