<advancedsettings>
  <!-- kodi-rt: Kodi reads this file (in the program folder) first, then your own
       %AppData%\Kodi\userdata\advancedsettings.xml, whose settings win. To change one, put it in yours.
       skiploopfilter: skip the in-loop filters (deblocking, and SAO for HEVC) of software-decoded video, such as x265,
       on the Tegra 3. Saves CPU at the cost of some blockiness. 48 = all frames (fastest), 32 = all but key frames,
       16 = B-frames only, 0 = off (Kodi's default). Hardware-decoded video (H.264 on the Surface) is not affected. -->
  <skiploopfilter>48</skiploopfilter>
</advancedsettings>
